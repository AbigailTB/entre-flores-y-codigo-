[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Administración de Proyectos"
tipo = "Acertijo"
enunciado = "Presupuesto: $10,000. Llevas 50% del trabajo y ya gastaste $7,000. ¿Cómo va el proyecto?"
opciones = Array[String](["Adelantado en tiempo", "Sobre presupuesto: gastas más de lo que avanzas", "Exactamente en presupuesto", "Bajo presupuesto"])
respuesta_correcta = 1
explicacion = "El valor ganado es $5,000 y el costo real $7,000: CPI ≈ 0.71."
puntos = 15
