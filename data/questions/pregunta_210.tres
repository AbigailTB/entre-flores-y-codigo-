[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Programación"
tipo = "Pregunta"
enunciado = "Este código lanza IndexError. ¿En qué línea está el error lógico?"
codigo = "frutas = [\"mango\", \"pera\", \"uva\"]\ni = 0\nwhile i <= len(frutas):\n    print(frutas[i])\n    i += 1"
opciones = Array[String](["Línea 1", "Línea 5", "Línea 4", "Línea 3"])
respuesta_correcta = 3
explicacion = "Con <= el ciclo llega a i = 3, pero el último índice válido es 2. La condición correcta es i < len(frutas)."
puntos = 10
