[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Seguridad Informática"
tipo = "Pregunta"
enunciado = "¿Por qué bcrypt es mejor que MD5 para guardar contraseñas?"
codigo = "import bcrypt\npw = \"secreto\".encode()\nh = bcrypt.hashpw(pw, bcrypt.gensalt())"
opciones = Array[String](["Es lento a propósito y usa una sal aleatoria", "Es más rápido que MD5", "Permite recuperar la contraseña original", "Siempre da el mismo hash para todos"])
respuesta_correcta = 0
explicacion = "La sal (gensalt) hace que dos contraseñas iguales den hashes distintos, y la lentitud frena la fuerza bruta. Un hash no se descifra."
puntos = 10
