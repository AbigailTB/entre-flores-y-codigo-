[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Metodologías Ágiles"
tipo = "Acertijo"
enunciado = "En XP, primero escribo una prueba que falla, luego el código mínimo y al final refactorizo. ¿Qué práctica soy?"
opciones = Array[String](["Scrum of Scrums", "Kanban", "Programación en pareja", "TDD (desarrollo guiado por pruebas)"])
respuesta_correcta = 3
explicacion = "TDD sigue el ciclo rojo, verde y refactorizar."
puntos = 15
