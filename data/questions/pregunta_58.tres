[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Ética Profesional"
enunciado = "¿Qué se espera de un profesional de TI ante un error grave que descubre en un sistema en producción?"
opciones = Array[String](["Reportarlo de forma responsable y transparente", "Ignorarlo", "Ocultarlo", "Culpar a otro compañero"])
respuesta_correcta = 0
explicacion = "La responsabilidad profesional implica comunicar los errores encontrados, no ocultarlos."
puntos = 10
