[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Metodología de la Investigación"
tipo = "Pregunta"
enunciado = "¿Qué sangría lleva cada entrada de la lista de referencias en APA 7?"
