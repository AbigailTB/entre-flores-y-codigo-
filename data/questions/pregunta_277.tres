[resource]
script = ExtResource("1")
materia = "Matemáticas"
tipo = "Acertijo"
enunciado = "¿Qué imprime este código Python?"
codigo = "x = 0b101 + 0x0A\ny = x % 4\nprint(x, y)"
opciones = Array[String](["15 1", "111 3", "15 3", "1010 2"])
