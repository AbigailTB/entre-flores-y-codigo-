[resource]
script = ExtResource("1")
materia = "Cálculo"
enunciado = "¿Qué representa la derivada de una función en un punto?"
opciones = Array[String](["La razón de cambio (pendiente) de la función en ese punto", "El área bajo la curva", "El valor máximo de la función", "El dominio de la función"])
