[resource]
script = ExtResource("1")
materia = "Diseño de Interfaces"
enunciado = "¿Por qué es importante la consistencia visual en una interfaz?"
opciones = Array[String](["Ayuda al usuario a entender y usar la aplicación más fácilmente", "Hace que el código sea más rápido", "Reduce el tamaño del archivo", "No tiene ningún efecto"])
