[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Bases de Datos"
tipo = "Pregunta"
enunciado = "¿Qué pasa al ejecutar esto?"
codigo = "BEGIN;\nUPDATE alumnos\nSET promedio = 10;\nCOMMIT;"
opciones = Array[String](["Marca error por no tener WHERE", "Solo cambia el primer alumno", "No cambia nada hasta usar SELECT", "Todos los alumnos quedan con promedio 10"])
respuesta_correcta = 3
explicacion = "Sin WHERE, UPDATE modifica TODAS las filas de la tabla, y COMMIT guarda el cambio. Es un error clásico: siempre revisa el WHERE."
puntos = 10
