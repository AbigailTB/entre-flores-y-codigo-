[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Redes de Computadoras"
tipo = "Pregunta"
enunciado = "En este archivo de puertos, ¿en qué línea está mal asignado el puerto?"
codigo = "http  = 80\nhttps = 443\nssh   = 23\ndns   = 53"
opciones = Array[String](["Línea 4", "Línea 3", "Línea 1", "Línea 2"])
respuesta_correcta = 1
explicacion = "SSH usa el puerto 22. El 23 es Telnet, un protocolo antiguo que manda todo sin cifrar. HTTP 80, HTTPS 443 y DNS 53 están bien."
puntos = 10
