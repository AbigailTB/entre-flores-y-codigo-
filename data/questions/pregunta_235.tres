[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Bases de Datos"
tipo = "Pregunta"
enunciado = "¿Qué filas devuelve esta consulta?"
codigo = "SELECT a.nombre, c.nombre\nFROM alumnos a\nINNER JOIN carreras c\n    ON a.carrera_id = c.id;"
opciones = Array[String](["Todas las combinaciones alumno-carrera", "Todos los alumnos, tengan o no carrera", "Solo alumnos con una carrera que coincide", "Todas las carreras, tengan o no alumnos"])
respuesta_correcta = 2
explicacion = "INNER JOIN solo deja filas que coinciden en ambas tablas. Para conservar a todos los alumnos aunque no tengan carrera se usa LEFT JOIN."
puntos = 10
