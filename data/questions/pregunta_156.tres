[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Seguridad Informática"
tipo = "Acertijo"
enunciado = "Te llega: \"Tu cuenta será bloqueada en 1 hora, da clic aquí\". ¿Qué técnica usa el atacante?"
