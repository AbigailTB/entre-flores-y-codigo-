[gd_resource type="Resource" script_class="Question" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Seguridad Informática"
tipo = "Acertijo"
enunciado = "Una skill de Alexa te pide por voz tu número de tarjeta \"para verificar tu cuenta\". ¿Qué es?"
opciones = Array[String](["Un error del micrófono", "Una actualización de seguridad", "Phishing por voz (vishing)", "Una función normal de Alexa"])
respuesta_correcta = 2
explicacion = "Nunca se deben dar datos financieros por voz a una skill que los pida."
puntos = 15
