[ext_resource type="Script" path="res://scripts/question.gd" id="1"]

[resource]
script = ExtResource("1")
materia = "Cálculo"
tipo = "Acertijo"
enunciado = "Un carrito se mueve con s(t) = t² − 4t. ¿En qué instante su velocidad es cero?"
