[resource]
script = ExtResource("1")
materia = "Bases de Datos"
tipo = "Acertijo"
enunciado = "La tabla salsas tiene 3 filas y la tabla papitas tiene 4. ¿Cuántas filas da un CROSS JOIN entre ellas?"
