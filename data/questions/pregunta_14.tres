[resource]
script = ExtResource("1")
enunciado = "¿Para qué sirve un sistema de control de versiones como Git?"
opciones = Array[String](["Para guardar el historial de cambios del código", "Para diseñar interfaces", "Para enviar correos", "Para hacer presentaciones"])
