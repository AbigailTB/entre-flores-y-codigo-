; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Entre Flores y Código"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/entre flores y codio"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

UiStyle="*res://scripts/ui_style.gd"
Transition="*res://scenes/transition/Transition.tscn"
QuestionBank="*res://scripts/question_bank.gd"
GameManager="*res://scripts/game_manager.gd"
Skills="*res://scripts/skills.gd"
Career="*res://scripts/career.gd"
FlowerCatalog="*res://scripts/flower_catalog.gd"
HUD="*res://scenes/ui/HUD.tscn"
DialogueBox="*res://scenes/ui/DialogueBox.tscn"
OutfitManager="*res://scripts/outfit_manager.gd"
AudioManager="*res://scenes/audio/AudioManager.tscn"
PauseMenu="*res://scenes/ui/PauseMenu.tscn"
CodeBugBank="*res://scripts/code_bug_bank.gd"
VictoryPanel="*res://scenes/ui/VictoryPanel.tscn"
SignatureReward="*res://scenes/ui/SignatureReward.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

